; IRONFRONT is a native Godot desktop game. Import this file in Godot 4.6+.
config_version=5

[application]
config/name="IRONFRONT · 1936"
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Real-time grand strategy with a historical 1936 map and capturable cities."
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1100
window/size/min_height=700
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.067, 0.09, 0.075, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true

[audio]
driver/enable_input=false
